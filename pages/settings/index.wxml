<view class="page">
  <view class="user-card">
    <view class="user-bg"></view>
    <view class="user-info">
      <view class="avatar">
        <text class="avatar-emoji">🐰</text>
      </view>
      <view class="user-text">
        <view class="user-name">我的假期</view>
        <view class="user-desc">假期 & 出差管理小助手</view>
      </view>
    </view>
  </view>

  <view class="stats-row card">
    <view class="stat-item">
      <view class="stat-num pink">{{stats.vacationRecords}}</view>
      <view class="stat-label">假期记录</view>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <view class="stat-num blue">{{stats.tripRecords}}</view>
      <view class="stat-label">出差记录</view>
    </view>
  </view>

  <view class="setting-section">
    <view class="section-title">⚙️ 基础设置</view>
    <view class="setting-list card">
      <view class="setting-item" bindtap="editAnnualLeave">
        <view class="setting-left">
          <text class="setting-icon">🌴</text>
          <text class="setting-name">年假总天数</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">{{settings.annualLeaveTotal}} 天</text>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="setting-divider"></view>
      <view class="setting-item" bindtap="editSubsidy">
        <view class="setting-left">
          <text class="setting-icon">💴</text>
          <text class="setting-name">每日补贴标准</text>
        </view>
        <view class="setting-right">
          <text class="setting-value">¥{{settings.subsidyPerDay}}/天</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="setting-section">
    <view class="section-title">📦 数据管理</view>
    <view class="setting-list card">
      <view class="setting-item" bindtap="exportData">
        <view class="setting-left">
          <text class="setting-icon">📤</text>
          <text class="setting-name">导出数据</text>
        </view>
        <view class="setting-right">
          <text class="setting-value text-muted">敬请期待</text>
          <text class="arrow">›</text>
        </view>
      </view>
      <view class="setting-divider"></view>
      <view class="setting-item danger" bindtap="clearData">
        <view class="setting-left">
          <text class="setting-icon">🗑️</text>
          <text class="setting-name">清除所有数据</text>
        </view>
        <view class="setting-right">
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="setting-section">
    <view class="section-title">ℹ️ 其他</view>
    <view class="setting-list card">
      <view class="setting-item" bindtap="about">
        <view class="setting-left">
          <text class="setting-icon">ℹ️</text>
          <text class="setting-name">关于</text>
        </view>
        <view class="setting-right">
          <text class="arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer-text">
    用 ❤️ 制作
  </view>
</view>
