.page {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.form-card {
  margin-bottom: 24rpx;
  padding: 12rpx 32rpx;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.form-divider {
  height: 1rpx;
  background: #F5F5F5;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.sub-tip {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.form-value {
  font-size: 28rpx;
  color: #666;
}

.form-value.picker {
  display: flex;
  align-items: center;
}

.form-value.highlight {
  color: #5B8FF9;
  font-weight: 500;
}

.form-value.pink {
  color: #FF6B9D;
  font-weight: 500;
}

.arrow {
  margin-left: 12rpx;
  color: #ccc;
  font-size: 32rpx;
}

.input-with-prefix {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
}

.prefix {
  font-size: 28rpx;
  color: #333;
  margin-right: 4rpx;
}

.money-input {
  width: 200rpx;
  text-align: right;
}

.form-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  padding: 24rpx 0 20rpx;
}

.status-options {
  display: flex;
  gap: 16rpx;
  padding-bottom: 24rpx;
}

.status-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #F9F9F9;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.status-option.active {
  background: linear-gradient(135deg, #E8F0FF, #D4E4FF);
  color: #5B8FF9;
  font-weight: 500;
}

.status-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.status-dot.pending {
  background: #FA8C16;
}

.status-dot.submitted {
  background: #5B8FF9;
}

.status-dot.reimbursed {
  background: #52C41A;
}

.remark-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  background: #F9F9F9;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 30rpx 40rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(240,248,255,0), #F0F8FF 30%);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #5B8FF9 0%, #8FB6FF 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(91, 143, 249, 0.4);
}

.submit-btn::after {
  border: none;
}
