.page {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

.stats-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
}

.stats-row {
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent, #F0F0F0, transparent);
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-num.pink {
  color: #FF6B9D;
}

.stat-num.blue {
  color: #5B8FF9;
}

.stat-num.orange {
  color: #FA8C16;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.tabs {
  display: flex;
  padding: 10rpx;
  margin-bottom: 24rpx;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #666;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #5B8FF9, #8FB6FF);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(91, 143, 249, 0.3);
}

.trip-list {
  display: flex;
  flex-direction: column;
}

.trip-card {
  margin-bottom: 20rpx;
}

.trip-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.trip-left {
  display: flex;
  align-items: center;
}

.trip-emoji {
  font-size: 44rpx;
  margin-right: 16rpx;
}

.trip-info {
  display: flex;
  flex-direction: column;
}

.trip-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.trip-destination {
  font-size: 24rpx;
  color: #999;
}

.trip-dates {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed #F0F0F0;
  margin-bottom: 20rpx;
}

.trip-days-badge {
  background: linear-gradient(135deg, #E8F0FF, #D4E4FF);
  color: #5B8FF9;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.trip-footer {
  display: flex;
  justify-content: space-around;
}

.footer-item {
  text-align: center;
}

.footer-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.footer-value {
  font-size: 28rpx;
  font-weight: 500;
}

.footer-value.pink {
  color: #FF6B9D;
}

.footer-value.blue {
  color: #5B8FF9;
}

.footer-value.orange {
  color: #FA8C16;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-emoji {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
}

.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 110rpx;
  height: 110rpx;
  background: linear-gradient(135deg, #5B8FF9, #8FB6FF);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(91, 143, 249, 0.5);
  z-index: 999;
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
}

.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-green {
  background: #E8FFF0;
  color: #52C41A;
}

.tag-blue {
  background: #E8F0FF;
  color: #5B8FF9;
}

.tag-orange {
  background: #FFF4E8;
  color: #FA8C16;
}
