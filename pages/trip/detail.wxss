.page {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.header-card {
  background: linear-gradient(135deg, #5B8FF9 0%, #8FB6FF 100%);
  color: #fff;
  margin-bottom: 24rpx;
}

.header-card .card-title {
  color: #fff;
}

.trip-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.trip-title-info {
  flex: 1;
}

.trip-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.trip-destination {
  font-size: 26rpx;
  opacity: 0.9;
}

.trip-date-range {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  opacity: 0.9;
}

.date-icon {
  margin-right: 10rpx;
}

.days-badge {
  margin-left: 16rpx;
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
}

.status-card {
  margin-bottom: 24rpx;
}

.status-options {
  display: flex;
  gap: 16rpx;
}

.status-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #F9F9F9;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.status-option.active {
  background: linear-gradient(135deg, #E8F0FF, #D4E4FF);
  color: #5B8FF9;
  font-weight: 500;
}

.status-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}

.status-dot.pending {
  background: #FA8C16;
}

.status-dot.submitted {
  background: #5B8FF9;
}

.status-dot.reimbursed {
  background: #52C41A;
}

.money-card {
  margin-bottom: 24rpx;
}

.money-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.money-item {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #FAFAFA;
  border-radius: 20rpx;
}

.money-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 16rpx;
}

.money-icon.pink {
  background: linear-gradient(135deg, #FFE8F0, #FFD4E4);
}

.money-icon.blue {
  background: linear-gradient(135deg, #E8F0FF, #D4E4FF);
}

.money-info {
  flex: 1;
}

.money-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.money-amount {
  font-size: 32rpx;
  font-weight: bold;
}

.money-amount.pink {
  color: #FF6B9D;
}

.money-amount.blue {
  color: #5B8FF9;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx dashed #F0F0F0;
}

.total-label {
  font-size: 28rpx;
  color: #666;
}

.total-amount {
  font-size: 40rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #FF6B9D, #FA8C16);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.remark-card {
  margin-bottom: 24rpx;
}

.remark-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.action-btns {
  display: flex;
  gap: 24rpx;
  padding: 0 10rpx;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #F5F5F5;
  color: #666;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.btn-danger {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #FFF0F0;
  color: #FF4D4F;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.btn-danger::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}
