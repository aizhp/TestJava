<view class="page">
  <view class="summary-card card">
    <view class="summary-item">
      <view class="summary-icon annual">🌴</view>
      <view class="summary-info">
        <view class="summary-name">年假剩余</view>
        <view class="summary-days">
          <text class="days-num">{{vacation.annualLeft}}</text>
          <text class="days-unit">天</text>
        </view>
      </view>
    </view>
    <view class="summary-divider"></view>
    <view class="summary-item">
      <view class="summary-icon comp">⏰</view>
      <view class="summary-info">
        <view class="summary-name">调休剩余</view>
        <view class="summary-days">
          <text class="days-num">{{vacation.compLeft}}</text>
          <text class="days-unit">天</text>
        </view>
      </view>
    </view>
  </view>

  <view class="tabs card">
    <view class="tab-item {{activeTab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="switchTab">
      全部
    </view>
    <view class="tab-item {{activeTab === 'annual' ? 'active' : ''}}" data-tab="annual" bindtap="switchTab">
      年假
    </view>
    <view class="tab-item {{activeTab === 'compensatory' ? 'active' : ''}}" data-tab="compensatory" bindtap="switchTab">
      调休
    </view>
    <view class="tab-item {{activeTab === 'sick' ? 'active' : ''}}" data-tab="sick" bindtap="switchTab">
      病假
    </view>
  </view>

  <view class="record-list">
    <view class="record-item card" wx:for="{{filteredRecords}}" wx:key="id">
      <view class="record-left">
        <view class="record-dot {{item.type}}"></view>
        <view class="record-info">
          <view class="record-top">
            <text class="record-type">{{item.typeLabel}}</text>
            <text class="record-direction tag {{item.direction === 'out' ? 'tag-pink' : 'tag-green'}}">
              {{item.direction === 'out' ? '请假' : '获得'}}
            </text>
          </view>
          <view class="record-date">{{item.dateCN}}</view>
          <view class="record-remark" wx:if="{{item.remark}}">{{item.remark}}</view>
        </view>
      </view>
      <view class="record-right">
        <view class="record-days {{item.direction}}">
          {{item.direction === 'out' ? '-' : '+'}}{{item.days}}天
        </view>
        <view class="delete-btn" data-id="{{item.id}}" catchtap="deleteRecord">
          <text>删除</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{filteredRecords.length === 0}}">
      <view class="empty-emoji">📭</view>
      <view class="empty-text">暂无记录</view>
      <view class="empty-tip">点击右下角按钮添加第一条记录吧</view>
    </view>
  </view>

  <view class="fab-btn" bindtap="goToAdd">
    <text class="fab-icon">+</text>
  </view>
</view>
