.page {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.direction-switch {
  display: flex;
  padding: 16rpx;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.switch-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0;
  border-radius: 24rpx;
  background: #F9F9F9;
  transition: all 0.3s ease;
}

.switch-item.active {
  background: linear-gradient(135deg, #FF6B9D, #FF8FB1);
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 157, 0.35);
}

.switch-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.switch-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.switch-item.active .switch-text {
  color: #fff;
}

.form-card {
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 24rpx;
}

.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  padding: 16rpx 32rpx;
  background: #F9F9F9;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s ease;
}

.type-item.active {
  background: linear-gradient(135deg, #FFE8F0, #FFD4E4);
  color: #FF6B9D;
  font-weight: 500;
}

.type-item.disabled {
  opacity: 0.35;
  pointer-events: none;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.form-divider {
  height: 1rpx;
  background: #F5F5F5;
  margin: 16rpx 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
}

.form-value {
  font-size: 28rpx;
  color: #666;
}

.form-value.picker {
  display: flex;
  align-items: center;
}

.arrow {
  margin-left: 12rpx;
  color: #ccc;
  font-size: 32rpx;
}

.days-picker {
  display: flex;
  align-items: center;
}

.days-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #666;
}

.days-input {
  width: 120rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin: 0 10rpx;
}

.days-unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 10rpx;
}

.remark-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  background: #F9F9F9;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.submit-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 30rpx 40rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255,245,248,0), #FFF5F8 30%);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FB1 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 157, 0.4);
}

.submit-btn::after {
  border: none;
}
