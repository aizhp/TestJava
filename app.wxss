page {
  background: linear-gradient(180deg, #FFF5F8 0%, #F0F8FF 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #333;
  min-height: 100vh;
}

.container {
  padding: 30rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 157, 0.1);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #FF6B9D, #FF8FB1);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B9D 0%, #FF8FB1 100%);
  color: white;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.4);
}

.btn-secondary {
  background: #F0F8FF;
  color: #5B8FF9;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
}

.tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.tag-pink {
  background: #FFE8F0;
  color: #FF6B9D;
}

.tag-blue {
  background: #E8F0FF;
  color: #5B8FF9;
}

.tag-green {
  background: #E8FFF0;
  color: #52C41A;
}

.tag-orange {
  background: #FFF4E8;
  color: #FA8C16;
}

.tag-gray {
  background: #F0F0F0;
  color: #999;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.text-primary {
  color: #FF6B9D;
}

.text-blue {
  color: #5B8FF9;
}
